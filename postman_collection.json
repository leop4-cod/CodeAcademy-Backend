{
	"info": {
		"name": "CodeAcademy API - 20 Tablas",
		"description": "Colección completa con CRUD para las 20 tablas del sistema CodeAcademy",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "accessToken",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Registro",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"usuario123\",\n  \"first_name\": \"Usuario\",\n  \"last_name\": \"Prueba\",\n  \"is_student\": true\n}"
						},
						"url": "{{baseUrl}}/auth/register/"
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access) { pm.collectionVariables.set('accessToken', json.access); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@codeacademy.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": "{{baseUrl}}/auth/login/"
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": "{{baseUrl}}/auth/token/refresh/"
					}
				}
			]
		},
